# ============================================
# EchoMind AI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Application
APP_NAME=EchoMind AI
APP_ENV=development
DEBUG=True
API_VERSION=v1
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://echomind_user:password@localhost:5432/echomind_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_TTL=3600

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_GPT4=gpt-4
OPENAI_MODEL_GPT35=gpt-3.5-turbo
OPENAI_MAX_TOKENS=150
OPENAI_TEMPERATURE=0.7

# AWS (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SECRETS_MANAGER_PREFIX=echomind/prod/

# Security
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=20

# Monitoring
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email (for parent alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@echomind.ai
SMTP_FROM_NAME=EchoMind AI

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=True

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/echomind.log

# Safety Filter
PII_DETECTION_ENABLED=True
JAILBREAK_DETECTION_ENABLED=True
SAFETY_LOG_RETENTION_DAYS=90

# Feature Flags
ENABLE_MYSTERY_SEEDS=True
ENABLE_KNOWLEDGE_TREE=True
ENABLE_PARENT_DASHBOARD=True
ENABLE_OFFLINE_CHALLENGES=True
